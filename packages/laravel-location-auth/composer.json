{
    "name": "sitebound/laravel-location-auth",
    "description": "Location-based authentication for Laravel Fortify and Inertia Vue applications.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "inertiajs/inertia-laravel": "^3.0",
        "laravel/fortify": "^1.34",
        "laravel/framework": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Sitebound\\LocationAuth\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Sitebound\\LocationAuth\\LocationAuthServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
