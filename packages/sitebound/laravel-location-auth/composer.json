{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "sitebound/laravel-location-auth",
    "description": "Location-based authentication support for Laravel applications.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/support": "^13.0",
        "laravel/fortify": "^1.34",
        "nesbot/carbon": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Sitebound\\LocationAuth\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Sitebound\\LocationAuth\\LocationAuthServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
